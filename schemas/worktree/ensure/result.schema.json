{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc worktree ensure --json result",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "command",
    "action",
    "path",
    "branch",
    "created",
    "branch_created"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "ok": { "const": true },
    "command": { "const": "worktree ensure" },
    "action": { "const": "ensure" },
    "path": { "type": "string" },
    "branch": { "type": "string" },
    "mode": { "enum": ["attached", "detached"] },
    "placement": { "enum": ["outside-worktrees", "within-repo-root"] },
    "head": { "type": "string" },
    "created": { "type": "boolean" },
    "branch_created": { "type": "boolean" },
    "planned": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "schema_version",
        "bead_id",
        "store_ref",
        "repo_identity",
        "path",
        "branch",
        "base_ref",
        "base_sha",
        "creator",
        "owner",
        "generation",
        "lifecycle"
      ],
      "properties": {
        "schema_version": { "enum": [1, 2] },
        "bead_id": { "type": "string" },
        "store_ref": { "type": "string" },
        "repo_identity": { "type": "string" },
        "path": { "type": "string" },
        "branch": { "type": "string" },
        "mode": { "enum": ["attached", "detached"] },
        "placement": { "enum": ["outside-worktrees", "within-repo-root"] },
        "base_ref": { "type": "string" },
        "base_sha": { "type": "string" },
        "creator": { "type": "string" },
        "owner": { "type": "string" },
        "generation": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "lifecycle": { "type": "string" },
        "attempt_id": { "type": "string" }
      },
      "oneOf": [
        {
          "properties": {
            "schema_version": { "const": 1 },
            "branch": { "minLength": 1 }
          },
          "not": { "anyOf": [{ "required": ["mode"] }, { "required": ["placement"] }] }
        },
        {
          "properties": { "schema_version": { "const": 2 } },
          "required": ["mode", "placement"],
          "if": { "properties": { "mode": { "const": "detached" } } },
          "then": { "properties": { "branch": { "const": "" } } },
          "else": { "properties": { "branch": { "minLength": 1 } } }
        }
      ],
      "additionalProperties": false
    }
  },
  "dependentRequired": { "mode": ["placement"], "placement": ["mode"] },
  "allOf": [
    {
      "if": {
        "required": ["provenance"],
        "properties": { "provenance": { "properties": { "schema_version": { "const": 2 } } } }
      },
      "then": { "required": ["mode", "placement"] }
    },
    {
      "if": { "required": ["mode"], "properties": { "mode": { "const": "detached" } } },
      "then": {
        "properties": {
          "branch": { "const": "" },
          "branch_created": { "const": false },
          "provenance": {
            "required": ["mode"],
            "properties": { "schema_version": { "const": 2 }, "mode": { "const": "detached" } }
          }
        }
      }
    },
    {
      "if": { "required": ["mode"], "properties": { "mode": { "const": "attached" } } },
      "then": {
        "properties": {
          "branch": { "minLength": 1 },
          "provenance": { "properties": { "mode": { "const": "attached" } } }
        }
      }
    },
    {
      "if": { "required": ["placement"], "properties": { "placement": { "const": "outside-worktrees" } } },
      "then": { "properties": { "provenance": { "properties": { "placement": { "const": "outside-worktrees" } } } } }
    },
    {
      "if": { "required": ["placement"], "properties": { "placement": { "const": "within-repo-root" } } },
      "then": { "properties": { "provenance": { "properties": { "placement": { "const": "within-repo-root" } } } } }
    }
  ],
  "additionalProperties": true
}
